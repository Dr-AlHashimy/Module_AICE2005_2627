\documentclass[tikz,border=5pt]{standalone}
\usepackage{tikz}
\usetikzlibrary{arrows.meta,positioning,fit,backgrounds,calc}

% ---- Colour & style definitions ----
\definecolor{techfill}{RGB}{207,232,255}      % light blue
\definecolor{techstroke}{RGB}{43,108,176}     % blue
\definecolor{orgfill}{RGB}{255,232,194}       % light orange
\definecolor{orgstroke}{RGB}{183,121,31}      % orange
\definecolor{sociofill}{RGB}{198,246,213}     % light green
\definecolor{sociostroke}{RGB}{47,133,90}     % green
\definecolor{boundarystroke}{RGB}{74,85,104}  % gray
\definecolor{boundarytext}{RGB}{45,55,72}

\tikzset{
  >=Latex,
  every node/.style={font=\sffamily\small, align=center},
  tech/.style={draw=techstroke, fill=techfill, rounded corners=2pt, line width=0.6pt, text=black, inner sep=3pt},
  org/.style={draw=orgstroke, fill=orgfill, rounded corners=2pt, line width=0.6pt, text=black, inner sep=3pt},
  socio/.style={draw=sociostroke, fill=sociofill, rounded corners=2pt, line width=0.6pt, text=black, inner sep=3pt},
  boundary/.style={draw=boundarystroke, line width=1pt, dashed, rounded corners=6pt},
  groupLabel/.style={font=\sffamily\bfseries\small, text=boundarytext},
  causal/.style={->, line width=0.8pt},
  looplabel/.style={fill=white, inner sep=1pt, font=\scriptsize\bfseries},
  legendbox/.style={draw=black!40, rounded corners=3pt, inner sep=6pt, fill=white}
}

\begin{document}
\begin{tikzpicture}[x=1cm,y=1cm,background rectangle/.style={fill=white}, show background rectangle]

% ======================================================
% FIXED LAYOUT ANCHORS (to avoid overlap)
% ======================================================
% Left cluster center (Organisational), Middle (Technical), Right (Socio)
\coordinate (CORG) at (-9, 0);
\coordinate (CTECH) at (  0, 0);
\coordinate (CSOC) at (  9, 0);

% ======================================================
% TECHNICAL NODES (center) — inside SCEMS boundary
% ======================================================
\node[tech] (T2) at ($(CTECH)+(-3,  2.5)$) {Hardware\\Obsolescence};
\node[tech] (T3) at ($(CTECH)+( 0,  2.5)$) {Data\\Latency};
\node[tech] (T4) at ($(CTECH)+( 3,  2.5)$) {Cybersecurity\\Breach};

\node[tech] (T1) at ($(CTECH)+(-3,  0)$) {Software\\Reliability};
\node[tech] (T6) at ($(CTECH)+( 0,  0)$) {Data Integrity\\Issue};
\node[tech] (T7) at ($(CTECH)+( 3,  0)$) {System Failure\\Rate};

\node[tech] (T5) at ($(CTECH)+( 0, -2.6)$) {AI Algorithm\\Bias};

% Technical boundary (SCEMS)
\node[boundary, fit=(T1)(T2)(T3)(T4)(T5)(T6)(T7), label={[boundarytext]above:Smart City Energy Management System}] (SCEMS) {};

% ======================================================
% ORGANISATIONAL NODES (left) — inside ORG boundary
% ======================================================
\node[org] (O1) at ($(CORG)+(-1.8,  2.8)$) {Supplier\\Dependency};
\node[org] (O2) at ($(CORG)+( 1.8,  2.8)$) {Communication\\Breakdown};

\node[org] (O5) at ($(CORG)+(-1.8,  0.9)$) {Unclear\\Accountability};
\node[org] (O6) at ($(CORG)+( 1.8,  0.9)$) {QA Gap\\(Reduced Testing)};

\node[org] (O3) at ($(CORG)+(-1.8, -1.0)$) {Resource Shortage\\(Funding Cuts)};
\node[org] (O4) at ($(CORG)+( 1.8, -1.0)$) {Decision\\Delay};

\node[org] (O7) at ($(CORG)+(-1.8, -2.9)$) {Technical\\Debt};
\node[org] (O8) at ($(CORG)+( 1.8, -2.9)$) {Bias Audit\\Process};

% Organisational boundary
\node[boundary, fit=(O1)(O2)(O3)(O4)(O5)(O6)(O7)(O8)] (ORGBOX) {};
\node[groupLabel, above=2pt of ORGBOX.north] {Organisational Domain};

% ======================================================
% SOCIO-ENVIRONMENTAL NODES (right) — inside SOC boundary
% ======================================================
\node[socio] (S5) at ($(CSOC)+( 0,  1.2)$) {Media\\Scrutiny};
\node[socio] (S4) at ($(CSOC)+( 3,  2.0)$) {Data Privacy\\Concerns};
\node[socio] (S2) at ($(CSOC)+( -3,  0.5)$) {Regulatory\\Change};
\node[socio] (S1) at ($(CSOC)+( 0, -1.5)$) {Public\\Trust};
\node[socio] (S3) at ($(CSOC)+(-3,  2.0)$) {Environmental\\Impact};

% Socio-environmental boundary
\node[boundary, fit=(S1)(S2)(S3)(S4)(S5)] (SOCBOX) {};
\node[groupLabel, above=2pt of SOCBOX.north] {Socio-environmental Domain};

% ======================================================
% CAUSAL LINKS (Organisational -> Technical)
% ======================================================
\draw[causal] (O2) -- (T6);
\draw[causal] (O2) -- (T3);
\draw[causal] (O3) -- (O6);
\draw[causal] (O6) -- (T1);
\draw[causal] (O6) -- (T7);
\draw[causal] (O5) -- (O2);
\draw[causal] (O2) -- (O4);
\draw[causal] (O4) -- (T3);
\draw[causal] (O1) -- (T2);
\draw[causal] (O7) -- (T1);
\draw[causal] (O7) -- (T3);
\draw[causal] (O7) -- (T4);

% ======================================================
% TECHNICAL INTERNAL PROPAGATION
% ======================================================
\draw[causal] (T2) -- (T3);
\draw[causal] (T1) -- (T6);
\draw[causal] (T6) -- (T7);

% ======================================================
% TECHNICAL -> SOCIO
% ======================================================
\draw[causal] (T4) -- (S4);
\draw[causal] (T4) -- (S2);
\draw[causal] (T3) -- (S1);
\draw[causal] (T7) -- (S1);

% ======================================================
% SOCIO -> ORG & CROSS-DOMAIN
% ======================================================
\draw[causal] (S5) -- (S2);
\draw[causal] (S3) -- (S2);
\draw[causal] (S4) -- (S1);
\draw[causal] (S2) -- (O4);

% Additional amplification
\draw[causal] (S1) -- (S5);
\draw[causal] (O6) -- (T4);

% ======================================================
% FEEDBACK LOOPS
% ======================================================
% R1: trust ↓ -> funding cuts -> QA gap -> failures -> trust ↓
\draw[causal, bend left=12] (S1) to node[looplabel, midway, above]{R1} (O3);
\draw[causal] (O3) -- (O6);
\draw[causal] (O6) -- (T7);
\draw[causal, bend left=12] (T7) to (S1);

% B1: bias -> regulation -> audits -> bias ↓
\draw[causal] (T5) -- (S2);
\draw[causal] (S2) -- (O8);
\draw[causal, bend left=10] (O8) to node[looplabel, midway, below]{B1} (T5);

% ======================================================
% LEGEND (BOTTOM, AWAY FROM OVERLAP)
% ======================================================
\node[legendbox, anchor=north] (LEG) at ($(CTECH)+(0,-7.2)$) {%
  \begin{tabular}{ll}
    \tikz{\node[tech, minimum width=12mm, minimum height=3mm]{};} & Technical domain (blue) \\
    \tikz{\node[org,  minimum width=12mm, minimum height=3mm]{};} & Organisational domain (orange) \\
    \tikz{\node[socio,minimum width=12mm, minimum height=3mm]{};} & Socio-environmental domain (green) \\
    \tikz{\draw[->, line width=0.8pt] (0,0) -- (1.0,0);} & Directed causal influence \\
    \textbf{R1} & Reinforcing loop (vicious cycle) \\
    \textbf{B1} & Balancing loop (mitigation/control) \\
  \end{tabular}
};

\end{tikzpicture}
\end{document}
